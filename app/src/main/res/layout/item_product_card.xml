<?xml version="1.0" encoding="utf-8"?>
<!--
    item_product_card.xml
    Used by rvForYou RecyclerView in DashboardActivity
    Width  : 160dp (horizontal scroll)
    Height : match RecyclerView height (220dp)
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="200dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Product Image — fills top 60% -->
        <ImageView
            android:id="@+id/ivProduct"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_cookie_velvet"
            android:contentDescription="Product image"
            android:layout_alignParentTop="true"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Info block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/ivProduct"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cookies"
                android:textColor="#B0A090"
                android:textSize="11sp"
                android:fontFamily="@font/lato_regular" />

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Red Velvet Cookie"
                android:textColor="#1A1008"
                android:textSize="13sp"
                android:fontFamily="@font/lato_bold"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Price + Add button row — pinned to bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentBottom="true"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rp. 8,000"
                android:textColor="#C8873A"
                android:textSize="13sp"
                android:fontFamily="@font/lato_bold"
                android:textStyle="bold" />

            <!-- Add to cart button (circular) -->
            <ImageView
                android:id="@+id/ivAddToCart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_add_button"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Add to cart" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>