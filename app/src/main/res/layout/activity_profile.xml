<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_main"
        android:scaleType="centerCrop"
        android:alpha="0.5"
        android:contentDescription="" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header Toolbar -->
        <LinearLayout
            android:id="@+id/profileToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="16dp"
            android:background="@android:color/transparent"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/ivProfileBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="180"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profil Saya"
                android:textColor="#1A1008"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View android:layout_width="36dp" android:layout_height="36dp" />
        </LinearLayout>

        <!-- Main Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="110dp"
            android:paddingBottom="150dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <!-- Profile Picture & Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#C8873A">

                        <ImageView
                            android:id="@+id/ivUserAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="24dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/white" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvProfileEmailDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="user@email.com"
                        android:textColor="#1A1008"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Edit Email Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Email"
                    android:textColor="#1A1008"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email baru"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="#1A1008"
                    android:textColorHint="#B0A090"
                    android:textSize="14sp" />

                <!-- Edit Password Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Password"
                    android:textColor="#1A1008"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etProfilePassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password baru"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="#1A1008"
                    android:textColorHint="#B0A090"
                    android:textSize="14sp" />

                <!-- Update Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateProfile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#C8873A"
                    android:text="Simpan Perubahan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:elevation="2dp" />

                <!-- Logout Button -->

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation Bar (floating pill style) -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="35dp"
            app:cardElevation="12dp"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
