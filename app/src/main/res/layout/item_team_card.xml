<?xml version="1.0" encoding="utf-8"?>
<!-- Root harus match_parent agar ViewPager2 tidak crash -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Container internal untuk membatasi tinggi kartu -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="550dp"
        android:layout_gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- FRONT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            android:outlineSpotShadowColor="#C8873A"
            android:outlineAmbientShadowColor="#C8873A"
            tools:targetApi="p">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivMemberPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_cookie_matcha" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvMemberName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex Carter"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMemberLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:text="24131310114"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMemberStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Programmer"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BACK CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:rotationY="180"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:outlineSpotShadowColor="#C8873A"
            android:outlineAmbientShadowColor="#C8873A"
            tools:targetApi="p">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Background Foto (Sama dengan depan) -->
                <ImageView
                    android:id="@+id/ivMemberPhotoBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_cookie_matcha" />

                <!-- Overlay Gelap 80% -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC1A1008" />

                <!-- Konten Teks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profil"
                        android:textColor="#C8873A"
                        android:textSize="14sp"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:background="#C8873A" />

                    <TextView
                        android:id="@+id/tvMemberDescription"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="20dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="6dp"
                        android:text="Detailed description about the member goes here. Their skills, passion, and role in the team."
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <!-- Social Media Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:id="@+id/ivInstagram"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:src="@drawable/formkit_instagram"
                            android:background="@drawable/bg_icon_circle"
                            app:tint="#C8873A"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"/>

                        <ImageView
                            android:id="@+id/ivGithub"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:src="@drawable/mdi_github"
                            android:background="@drawable/bg_icon_circle"
                            app:tint="#C8873A"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"/>

                        <ImageView
                            android:id="@+id/ivLinkedin"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:src="@drawable/mdi_linkedin"
                            android:background="@drawable/bg_icon_circle"
                            app:tint="#C8873A"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>